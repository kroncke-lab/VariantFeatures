# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Data. Slashless and anchored on purpose: locally `data` is an absolute symlink
# to external storage, and a trailing-slash pattern matches directories only — it
# would leave a recreated symlink showing as untracked in a fresh checkout.
/data
*.db
*.sqlite
*.tbi
*.vcf.gz
# Internal collaborator handoff bundles (not needed to run the tool)
handoff/

# macOS
.DS_Store

# Licensed third-party tools
annovar/
annovar.latest.tar.gz

# Environment
.env
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp

# Testing
.pytest_cache/
.coverage
htmlcov/
